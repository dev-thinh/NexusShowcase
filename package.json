{
  "name": "nexus-showcase",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "postcss": "$postcss",
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "postcss-selector-parser": "7.1.7"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "preview": "node scripts/start-production.mjs",
    "check:pages": "node scripts/check-cold-pages.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "typecheck": "tsc --noEmit --project tsconfig.check.json",
    "check:unused": "tsc --noEmit --project tsconfig.check.json --noUnusedLocals --noUnusedParameters && node scripts/audit-unused.mjs --check",
    "check": "npm run typecheck && npm run check:unused && npm run check:architecture && npm run test:unit",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/run-browser-harness.ts e2e",
    "bench:navigation": "tsx scripts/run-browser-harness.ts benchmark",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:verify-upgrade": "tsx scripts/verify-database-upgrade.ts",
    "db:inventory": "tsx scripts/verify-database-upgrade.ts --inventory",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:mock": "tsx prisma/seed-mock-posts.ts",
    "check:architecture": "node scripts/check-architecture.mjs",
    "audit:unused": "node scripts/audit-unused.mjs",
    "audit:assets": "tsx scripts/audit-asset-references.ts",
    "assets:check:imagekit": "tsx scripts/check-imagekit.ts",
    "assets:cleanup:local-images": "tsx scripts/cleanup-local-images.ts",
    "db:normalize-types": "tsx prisma/normalize-content-types.ts",
    "db:seed:categories": "tsx prisma/seed-categories.ts",
    "db:cleanup-rate-limits": "tsx scripts/cleanup-rate-limits.ts",
    "assets:inventory": "tsx scripts/inventory-asset-registry.ts",
    "assets:cleanup:orphans": "tsx scripts/cleanup-orphan-assets.ts",
    "assets:reconcile:imagekit": "tsx scripts/reconcile-imagekit-assets.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "lucide-react": "^0.468.0",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.31",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "4.1.12"
  }
}
