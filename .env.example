DATABASE_URL="postgresql://nexus:nexus_secret_2026@localhost:5434/nexus_showcase?schema=public"
AUTH_SECRET="your-32-characters-auth-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# Storage: use imagekit after configuring its server-side credentials.
ASSET_STORAGE="local"
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"
IMAGEKIT_FOLDER="nexus-showcase"

# Bootstrap & Seed Configuration
BOOTSTRAP_ADMIN_EMAIL="admin01"
BOOTSTRAP_ADMIN_PASSWORD="change_this_local_admin_password_2026"
RESET_DATABASE="false"

# Dedicated Test Database (Required for database integration tests, must differ from DATABASE_URL)
TEST_DATABASE_URL="postgresql://nexus:nexus_secret_2026@localhost:5434/nexus_showcase_test?schema=public"

# Alternative isolated docker-compose.test.yml service (test data is ephemeral):
# TEST_DATABASE_URL="postgresql://nexus_test:local_test_only@localhost:5435/nexus_showcase_test?schema=public"
# Browser harness uses installed Chromium, or HARNESS_BROWSER_CHANNEL=msedge locally.
