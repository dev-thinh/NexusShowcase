DATABASE_URL="postgresql://nexus_runtime:CHANGE_ME@127.0.0.1:5434/nexus_showcase?schema=public"
# Generate with: openssl rand -base64 48
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Storage: use imagekit after configuring its server-side credentials.
ASSET_STORAGE="local"
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"
IMAGEKIT_FOLDER="nexus-showcase"

# Bootstrap & Seed Configuration
BOOTSTRAP_ADMIN_EMAIL="admin01"
# Set a private password: at least 15 characters, at most 72 UTF-8 bytes.
BOOTSTRAP_ADMIN_PASSWORD=""
# Demo credentials are permitted only on an explicitly disposable demo database.
ALLOW_DEMO_SEED="false"

# Keep maintenance credentials in .env.database.local and test credentials in
# .env.test.local (copy their .example files); neither file is loaded by Next dev.

# Hard storage limits include assets plus durable in-flight reservations.
UPLOAD_OWNER_MAX_BYTES="209715200"
UPLOAD_TOTAL_MAX_BYTES="2147483648"
UPLOAD_OWNER_MAX_FILES="200"
UPLOAD_TOTAL_MAX_FILES="2000"
UPLOAD_OWNER_CONCURRENCY="2"
UPLOAD_TOTAL_CONCURRENCY="8"
